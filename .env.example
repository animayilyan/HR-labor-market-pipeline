# Copy to .env. This API needs no key.
API_URL=https://www.arbeitnow.com/api/job-board-api
REQUEST_TIMEOUT=15
MAX_RETRIES=3
MAX_PAGES=10
PAGE_DELAY_SECONDS=1
DB_PATH=data/processed/pipeline.db
# Optional, only for the LLM fallback step. Paste your own key here yourself, never in chat.
ANTHROPIC_API_KEY=
# Optional MySQL copy of the tables. Leave MYSQL_PASSWORD empty to skip MySQL.
# Type your own password into .env yourself; never paste it in chat.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=hr_jobs
